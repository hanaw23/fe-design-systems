{
  "name": "@fe-design-systems/react",
  "version": "0.1.4",
  "description": "React components for FE Design Systems",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanaw23/fe-design-systems.git"
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "antd",
    "ant-design",
    "ui-components"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "antd": "^6.6.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fe-design-systems/tokens": "^0.1.0"
  }
}
